# Required: your Crustdata API key (https://docs.crustdata.com)
CRUSTDATA_API_KEY=

# Companies whose alumni you track (website domains)
TRACKED_COMPANIES=openai.com,anthropic.com,deepmind.google,stripe.com,databricks.com,ramp.com,figma.com,scale.com
SINCE_DAYS=90          # stealth role started in the last N days
LEFT_WITHIN_DAYS=270   # left the tracked company in the last N days
COUNTRY=               # e.g. United States (empty = worldwide)

# Optional: Slack incoming webhook for the weekly digest (leave empty to skip)
SLACK_WEBHOOK_URL=

# Optional: Claude adds a one-line diligence note per founder (pip install -r requirements-optional.txt)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
